{
  "name": "pi-helios",
  "version": "0.2.0",
  "description": "Consent-gated browser and Android-emulator automation plus Windows-window screenshots for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
