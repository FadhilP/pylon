{
  "name": "pylon-core",
  "version": "0.1.0",
  "description": "Optional runtime coordination for interoperable Pi packages",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./child-process": "./src/child-process.ts",
    "./context-packing": "./src/context-packing.ts",
    "./delegate-retry": "./src/delegate-retry.ts",
    "./executable": "./src/executable.ts",
    "./json-config": "./src/json-config.ts",
    "./redact": "./src/redact.ts",
    "./token-meter": "./src/token-meter.ts",
    "./session-inventory": "./src/session-inventory.ts",
    "./utf8": "./src/utf8.ts",
    "./verification-worktree": "./src/verification-worktree.ts",
    "./extensions/*": "./extensions/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/pylon-core.ts"
    ]
  },
  "pylon": {
    "settings": "./src/web-settings.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
