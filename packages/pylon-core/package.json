{
  "name": "pylon-core",
  "version": "0.1.0",
  "description": "Optional runtime coordination for interoperable Pi packages",
  "type": "module",
  "keywords": ["pi-package"],
  "engines": { "node": ">=22.19.0" },
  "files": ["extensions", "src", "README.md", "LICENSE"],
  "exports": {
    "./delegate-retry": "./src/delegate-retry.ts",
    "./token-meter": "./src/token-meter.ts",
    "./utf8": "./src/utf8.ts",
    "./extensions/*": "./extensions/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit"
  },
  "pi": {
    "extensions": ["./extensions/pylon-core.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "license": "MIT"
}
