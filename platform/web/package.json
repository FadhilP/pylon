{
  "name": "@pylon/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-transform-types src/server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node --experimental-transform-types src/server/index.ts --production",
    "preview": "npm run start",
    "test": "node --experimental-transform-types --test-concurrency=2 --test test/*.test.ts",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm test && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@tabler/icons-react": "^3.31.0",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "pylon-core": "0.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
