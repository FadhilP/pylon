{
  "name": "@pylon/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-transform-types src/server/start.ts",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "vite build --ssr src/server/index.ts --outDir dist-server/server --emptyOutDir",
    "start": "node --experimental-transform-types src/server/start.ts --production",
    "preview": "npm run start",
    "test": "node --experimental-transform-types --test-concurrency=1 --test test/*.test.ts",
    "check": "npm run typecheck",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm test && npm run build"
  },
  "dependencies": {
    "@appland/sql-parser": "^1.5.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/json": "^1.0.3",
    "@napi-rs/keyring": "1.3.0",
    "@tabler/icons-react": "^3.46.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "9.0.0",
    "dompurify": "^3.4.14",
    "jiti": "^2.7.0",
    "katex": "^0.18.5",
    "marked": "^18.0.5",
    "node-pty": "^1.1.0",
    "node-sql-parser": "^5.4.0",
    "pi-stateql": "0.1.0",
    "pylon-core": "0.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "^4.4.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "material-icon-theme": "^5.38.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
