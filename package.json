{
  "name": "@fadhilp/pylon",
  "version": "1.4.0",
  "workspaces": [
    "packages/*",
    "platform/web"
  ],
  "description": "Pi workflow extensions and a local web interface.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FadhilP/pylon.git"
  },
  "homepage": "https://github.com/FadhilP/pylon#readme",
  "bugs": "https://github.com/FadhilP/pylon/issues",
  "keywords": [
    "pi-package",
    "coding-agent",
    "developer-tools"
  ],
  "bin": {
    "pylon": "./bin/pylon.mjs"
  },
  "files": [
    "bin",
    "packages/*/bin/**",
    "packages/*/extensions/**",
    "packages/*/src/**",
    "packages/*/themes/**",
    "packages/*/package.json",
    "packages/*/README.md",
    "packages/*/LICENSE",
    "skills",
    "platform/web/dist",
    "platform/web/dist-server",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "verify": "npm run test:bundle && npm run test:update && node scripts/run-packages.mjs verify && npm run verify --workspace @pylon/web",
    "verify:fast": "npm run test:bundle && npm run test:update && node scripts/run-packages.mjs check && npm run build --workspace @pylon/web",
    "test:bundle": "node --experimental-transform-types --test-isolation=none --test-force-exit --test test/bundle.test.ts",
    "test:update": "node --test test/update.test.mjs",
    "test:package": "node --test test/package.test.mjs",
    "check:packages": "node scripts/run-packages.mjs check",
    "test:packages": "node scripts/run-packages.mjs test",
    "install:packages": "npm install --workspaces --include-workspace-root",
    "prepack": "npm run build --workspace @pylon/web",
    "prepublishOnly": "npm run verify && npm run test:package",
    "web": "node scripts/web.mjs",
    "web:update": "git pull --ff-only && npm run web",
    "release": "npm version",
    "version": "npm install"
  },
  "pi": {
    "extensions": [
      "./packages/pi-advisor/extensions/pi-advisor.ts",
      "./packages/pylon-core/extensions/pylon-core.ts",
      "./packages/pi-continuity/extensions/pi-continuity.ts",
      "./packages/pi-focus/extensions/pi-focus.ts",
      "./packages/pi-guard/extensions/pi-guard.ts",
      "./packages/pi-grunt/extensions/pi-grunt.ts",
      "./packages/pi-heartbeat/extensions/pi-heartbeat.ts",
      "./packages/pi-helios/extensions/pi-helios.ts",
      "./packages/pi-stateql/extensions/pi-stateql.ts",
      "./packages/pi-discover/extensions/pi-discover.ts",
      "./packages/pi-scout/extensions/pi-scout.ts",
      "./packages/pi-spawn/extensions/pi-spawn.ts",
      "./packages/pi-sieve/extensions/pi-sieve.ts",
      "./packages/pi-timeline/extensions/pi-timeline.ts",
      "./packages/pi-verify/extensions/pi-verify.ts"
    ],
    "themes": [
      "./packages/pi-focus/themes/focus-dark.json"
    ]
  },
  "dependencies": {
    "@fadhilp/stateql": "0.5.2",
    "@playwright/cli": "0.1.17",
    "jiti": "^2.7.0",
    "node-pty": "^1.1.0",
    "pylon-core": "0.1.0",
    "ws": "^8.21.1"
  },
  "bundleDependencies": [
    "pylon-core"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0"
  }
}
