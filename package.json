{
  "name": "pylon",
  "version": "0.16.2",
  "private": true,
  "workspaces": [
    "packages/*",
    "platform/web"
  ],
  "description": "Complete Pylon package with all extensions and themes.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "verify": "npm run test:bundle && node scripts/run-packages.mjs verify && npm run verify --workspace @pylon/web",
    "verify:fast": "npm run test:bundle && node scripts/run-packages.mjs check && npm run build --workspace @pylon/web",
    "test:bundle": "node --experimental-transform-types --test-isolation=none --test-force-exit --test test/bundle.test.ts",
    "check:packages": "node scripts/run-packages.mjs check",
    "test:packages": "node scripts/run-packages.mjs test",
    "install:packages": "npm install --workspaces --include-workspace-root",
    "web": "npm run build --workspace @pylon/web && npm run start --workspace @pylon/web",
    "web:update": "git pull --ff-only && npm run web"
  },
  "pi": {
    "extensions": [
      "./packages/pi-advisor/extensions/pi-advisor.ts",
      "./packages/pylon-core/extensions/pylon-core.ts",
      "./packages/pi-continuity/extensions/pi-continuity.ts",
      "./packages/pi-focus/extensions/pi-focus.ts",
      "./packages/pi-guard/extensions/pi-guard.ts",
      "./packages/pi-grunt/extensions/pi-grunt.ts",
      "./packages/pi-heartbeat/extensions/pi-heartbeat.ts",
      "./packages/pi-helios/extensions/pi-helios.ts",
      "./packages/pi-discover/extensions/pi-discover.ts",
      "./packages/pi-scout/extensions/pi-scout.ts",
      "./packages/pi-sieve/extensions/pi-sieve.ts",
      "./packages/pi-timeline/extensions/pi-timeline.ts",
      "./packages/pi-verify/extensions/pi-verify.ts"
    ],
    "themes": [
      "./packages/pi-focus/themes/focus-dark.json"
    ]
  },
  "dependencies": {
    "@playwright/cli": "0.1.17"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0"
  }
}
